# ── APAR voice concierge (ElevenLabs Agents) ──────────────────────────────
# Create an agent at https://elevenlabs.io/app/agents, copy its Agent ID, and
# paste it here (then copy this file to .env.local). See docs/voice-concierge.md.
# Until this is set, the floating orb falls back to linking to #contact.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ── Fit brand font (Adobe Fonts web project) ──────────────────────────────
# The xxxxxxx in https://use.typekit.net/xxxxxxx.css  (see lib/adobe-fonts.ts)
NEXT_PUBLIC_ADOBE_FONTS_KIT=

# ── Project brief form (/start) ───────────────────────────────────────────
# Any endpoint that accepts a JSON POST of the brief (Formspree, Basin, your own
# API route). Leave empty and the form opens the visitor's email app with the
# brief addressed to the studio instead - it is never dropped.
NEXT_PUBLIC_BRIEF_ENDPOINT=

# Private APĀR client voice-note inbox (apar-one-front Supabase organization only).
# Set these in .env.local and Vercel Project Settings > Environment Variables.
# Use a Supabase sb_secret_ key. Never prefix it NEXT_PUBLIC_ or commit it.
APAR_VOICE_SUPABASE_URL=https://msqfxdqeilrzmsddlxwl.supabase.co
APAR_VOICE_SUPABASE_SECRET_KEY=
